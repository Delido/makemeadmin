{
  "name": "RunAsAdmin Server",
  "version": "0.10.0",
  "slug": "runasadmin_server",
  "description": "Zentrale Steuerung und Verlauf fuer RunAsAdmin auf den Kinder-PCs",
  "url": "https://github.com/Delido/makemeadmin",
  "arch": ["amd64", "aarch64", "armv7"],
  "init": false,
  "ingress": true,
  "ingress_port": 8099,
  "panel_icon": "mdi:shield-account",
  "panel_title": "RunAsAdmin",
  "ports": {
    "8099/tcp": 8099
  },
  "ports_description": {
    "8099/tcp": "API fuer die Kinder-PCs (RunAsAdmin-Dienst)"
  },
  "hassio_api": true,
  "homeassistant_api": true,
  "map": ["addon_config:rw"],
  "options": {
    "pc_token": "",
    "notify_service": "",
    "dashboard_pin": ""
  },
  "schema": {
    "pc_token": "password",
    "notify_service": "str?",
    "dashboard_pin": "password?"
  }
}
