<Window x:Class="RunAsAdmin.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RunAsAdmin" Height="600" Width="860" MinHeight="520" MinWidth="760"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResizeWithGrip" AllowsTransparency="True"
        Background="Transparent" FontFamily="Segoe UI Variable, Segoe UI"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True">

    <Window.Resources>
        <SolidColorBrush x:Key="Bg" Color="#0E1116"/>
        <SolidColorBrush x:Key="Sidebar" Color="#151A21"/>
        <SolidColorBrush x:Key="Card" Color="#1A202A"/>
        <SolidColorBrush x:Key="Stroke" Color="#22FFFFFF"/>
        <SolidColorBrush x:Key="Text" Color="#E6E9EE"/>
        <SolidColorBrush x:Key="Muted" Color="#8A93A1"/>
        <SolidColorBrush x:Key="Accent" Color="#2FBF71"/>

        <!-- Navigations-Button in der Seitenleiste -->
        <Style x:Key="NavBtn" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="Margin" Value="10,3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="b" CornerRadius="12" Padding="14,11" Background="Transparent">
                            <StackPanel>
                                <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                           FontSize="20" HorizontalAlignment="Center"/>
                                <TextBlock Text="{TemplateBinding Content}" FontSize="11"
                                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#20FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#243042"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="56"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" CornerRadius="14">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#2FBF71" Offset="0"/>
                                    <GradientStop Color="#249E5C" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="RenderTransform">
                                    <Setter.Value><ScaleTransform ScaleX="1.01" ScaleY="1.03" CenterX="140" CenterY="28"/></Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="b" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="16" Background="{StaticResource Bg}" BorderBrush="{StaticResource Stroke}" BorderThickness="1">
        <Border.Effect><DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.55" Color="Black"/></Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="104"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Seitenleiste -->
            <Border Grid.Column="0" Background="{StaticResource Sidebar}" CornerRadius="16,0,0,16">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Height="64">
                        <TextBlock Text="🛡" FontSize="30" Foreground="{StaticResource Accent}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel x:Name="Nav" DockPanel.Dock="Top" Margin="0,8,0,0">
                        <RadioButton x:Name="NavStart" Style="{StaticResource NavBtn}" Tag="🏠" Content="Start"
                                     IsChecked="True" Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavGames" Style="{StaticResource NavBtn}" Tag="🚀" Content="Apps"
                                     Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavHistory" Style="{StaticResource NavBtn}" Tag="📜" Content="Verlauf"
                                     Checked="Nav_Checked"/>
                        <RadioButton x:Name="NavStatus" Style="{StaticResource NavBtn}" Tag="📊" Content="Status"
                                     Checked="Nav_Checked"/>
                    </StackPanel>
                    <RadioButton x:Name="NavSettings" DockPanel.Dock="Bottom" Style="{StaticResource NavBtn}"
                                 Tag="⚙" Content="Eltern" Margin="10,0,10,14" Checked="Nav_Checked"/>
                </DockPanel>
            </Border>

            <!-- Content -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="46"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Titelleiste (Drag + Schließen) -->
                <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_Drag">
                    <TextBlock x:Name="PageTitle" Text="Start" Foreground="{StaticResource Muted}"
                               FontSize="12.5" VerticalAlignment="Center" Margin="22,0,0,0"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="—" Click="Minimize_Click" Width="42" Height="46" Cursor="Hand"
                                Foreground="#C9CED8" FontSize="14" Background="Transparent" BorderThickness="0"/>
                        <Button Content="✕" Click="CloseWindow_Click" Width="42" Height="46" Cursor="Hand"
                                Foreground="#C9CED8" FontSize="14" Background="Transparent" BorderThickness="0"/>
                    </StackPanel>
                </Grid>

                <!-- Seiten -->
                <Grid Grid.Row="1" Margin="22,4,22,22">
                    <!-- START -->
                    <Grid x:Name="PageStart">
                        <StackPanel VerticalAlignment="Center" MaxWidth="460">
                            <TextBlock Text="Adminrechte" Foreground="{StaticResource Text}" FontSize="30" FontWeight="Bold"/>
                            <TextBlock x:Name="StartSub" Foreground="{StaticResource Muted}" FontSize="14" Margin="0,6,0,0"
                                       TextWrapping="Wrap"
                                       Text="Fordere für 15 Minuten Adminrechte an. Papa bestätigt auf dem Handy. Danach kannst du deine Programme selbst starten."/>

                            <!-- Status-Karte -->
                            <Border x:Name="StatusCard" Background="{StaticResource Card}" CornerRadius="14"
                                    BorderBrush="{StaticResource Stroke}" BorderThickness="1" Padding="18" Margin="0,22,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="StatusDot" Text="●" FontSize="16" Foreground="#5A6372" VerticalAlignment="Center"/>
                                    <StackPanel Margin="12,0,0,0">
                                        <TextBlock x:Name="StatusTitle" Text="Keine Adminrechte aktiv"
                                                   Foreground="{StaticResource Text}" FontSize="15" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="StatusDetail" Text="Du bist normaler Benutzer."
                                                   Foreground="{StaticResource Muted}" FontSize="12.5" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Button x:Name="RequestBtn" Style="{StaticResource PrimaryBtn}" Margin="0,18,0,0"
                                    Content="Adminrechte anfragen (15 Min)" Click="Request_Click"/>

                            <!-- Fallback: lokal per Eltern-PIN, falls HA/Server nicht erreichbar ist -->
                            <Button x:Name="LocalPinBtn" Click="LocalPin_Click" Cursor="Hand"
                                    Margin="0,10,0,0" HorizontalAlignment="Center"
                                    Background="Transparent" BorderThickness="0"
                                    Foreground="#8A909B" FontSize="12.5"
                                    Content="Papa ist da? Mit Eltern-PIN freischalten"/>

                            <!-- Warnung: Konto ist dauerhaft Admin -> Tool wirkungslos -->
                            <Border x:Name="AdminWarn" Visibility="Collapsed" Margin="0,16,0,0"
                                    Background="#2A1416" CornerRadius="12" BorderBrush="#E05A4A" BorderThickness="1" Padding="16">
                                <StackPanel>
                                    <TextBlock Text="⚠️ Dieses Konto ist dauerhaft Administrator"
                                               Foreground="#FF8A7A" FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock Foreground="#D9A39A" FontSize="12.5" Margin="0,4,0,0" TextWrapping="Wrap"
                                               Text="Solange das so ist, kann RunAsAdmin nichts kontrollieren. Stufe das Konto auf Standardbenutzer herunter."/>
                                    <Button x:Name="DemoteBtn" Content="Auf Standardbenutzer herunterstufen"
                                            Click="Demote_Click" Margin="0,10,0,0" Height="38" Cursor="Hand"
                                            Foreground="White" Background="#B5362C" BorderThickness="0" FontSize="13"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- VERLAUF -->
                    <Grid x:Name="PageHistory" Visibility="Collapsed">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Verlauf" Foreground="{StaticResource Text}"
                                       FontSize="24" FontWeight="Bold" Margin="0,0,0,12"/>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="HistoryList"/>
                            </ScrollViewer>
                        </DockPanel>
                    </Grid>

                    <!-- APPS (dauerhaft freigegebene Programme: Spiele + Tools) -->
                    <Grid x:Name="PageGames" Visibility="Collapsed">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Apps" Foreground="{StaticResource Text}"
                                       FontSize="24" FontWeight="Bold" Margin="0,0,0,4"/>
                            <TextBlock DockPanel.Dock="Top" Foreground="{StaticResource Muted}" FontSize="13"
                                       TextWrapping="Wrap" Margin="0,0,0,14"
                                       Text="Dauerhaft freigegebene Programme (Spiele und Tools). Starten mit Adminrechten – ohne Nachfrage. Neue per Rechtsklick auf die .exe: 'Mit Adminrechten anfragen' und 'Immer erlauben' freigeben."/>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <ItemsControl x:Name="GamesList"/>
                                    <TextBlock x:Name="GamesEmpty" Visibility="Collapsed"
                                               Foreground="{StaticResource Muted}" FontSize="13.5" Margin="2,8,0,0"
                                               Text="Noch keine Programme dauerhaft freigegeben."/>
                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>
                    </Grid>

                    <!-- STATUS -->
                    <Grid x:Name="PageStatus" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="Status" Foreground="{StaticResource Text}" FontSize="24" FontWeight="Bold" Margin="0,0,0,12"/>
                            <Border Background="{StaticResource Card}" CornerRadius="14" BorderBrush="{StaticResource Stroke}"
                                    BorderThickness="1" Padding="18">
                                <StackPanel x:Name="StatusInfo"/>
                            </Border>
                            <Button x:Name="UpdateBtn" Content="Nach Updates suchen" Click="Update_Click"
                                    HorizontalAlignment="Left" Cursor="Hand" Foreground="#8A93A6" FontSize="13"
                                    Background="Transparent" BorderThickness="0" Margin="0,14,0,0" Padding="2"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>

            <!-- Overlay (Warten/Ergebnis) -->
            <Grid x:Name="Overlay" Grid.ColumnSpan="2" Visibility="Collapsed">
                <Rectangle Fill="#0E1116" Opacity="0.82"/>
                <Border Background="{StaticResource Card}" CornerRadius="18" Padding="36,30"
                        BorderBrush="{StaticResource Stroke}" BorderThickness="1"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Width="400">
                    <Border.Effect><DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.5" Color="Black"/></Border.Effect>
                    <StackPanel>
                        <TextBlock x:Name="OverlayIcon" Text="⏳" FontSize="46" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="OverlayTitle" Foreground="White" FontSize="19" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Margin="0,12,0,0" TextAlignment="Center" TextWrapping="Wrap"/>
                        <TextBlock x:Name="OverlayText" Foreground="{StaticResource Muted}" FontSize="13.5"
                                   HorizontalAlignment="Center" Margin="0,8,0,0" TextAlignment="Center" TextWrapping="Wrap"/>
                        <ProgressBar x:Name="OverlayBar" IsIndeterminate="True" Height="5" Margin="0,22,0,0"
                                     Background="#243042" Foreground="{StaticResource Accent}" BorderThickness="0"/>
                        <Button x:Name="OverlayClose" Content="Schließen" Click="OverlayClose_Click" Visibility="Collapsed"
                                Margin="0,22,0,0" Height="40" Width="150" HorizontalAlignment="Center" Cursor="Hand"
                                Foreground="White" Background="#2C3340" BorderThickness="0"/>
                        <Button x:Name="OverlayCancel" Content="Abbrechen" Click="OverlayCancel_Click" Visibility="Collapsed"
                                Margin="0,22,0,0" Height="40" Width="150" HorizontalAlignment="Center" Cursor="Hand"
                                Foreground="#CFD3DA" Background="#2C3340" BorderThickness="0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
