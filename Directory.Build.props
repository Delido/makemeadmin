<Project>
  <!-- Zentrale Version fuer ALLE Projekte (GUI, Service, Installer).
       So stimmt die Dateiversion jeder exe/dll mit dem Release ueberein. -->
  <PropertyGroup>
    <Version>1.6.6</Version>
    <AssemblyVersion>1.6.6.0</AssemblyVersion>
    <FileVersion>1.6.6.0</FileVersion>
    <InformationalVersion>1.6.6</InformationalVersion>
    <!-- Sicherstellen, dass die Versionsattribute wirklich erzeugt werden. -->
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <GenerateAssemblyVersionAttribute>true</GenerateAssemblyVersionAttribute>
    <GenerateAssemblyFileVersionAttribute>true</GenerateAssemblyFileVersionAttribute>
  </PropertyGroup>
</Project>
